# Copy this file to .env and fill in real values before running the server

PORT=4000

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Where the SQLite database file is stored
DB_PATH=./data/pdfstation.db

# Where uploaded/processed files are temporarily stored
STORAGE_PATH=./storage

# Max upload size per file, in megabytes
MAX_FILE_SIZE_MB=25

# Comma-separated list of origins allowed to call this API
# e.g. http://localhost:5500,https://yourdomain.com
CORS_ORIGIN=*

# The email address that is allowed to access the admin panel (/admin)
# Change this to your own email before deploying
ADMIN_EMAIL=you@example.com

# Secret key to access the admin panel (/admin.html) — pick any long random string.
# Whoever knows this key can see the list of registered users.
ADMIN_SECRET=change-this-to-another-long-random-string
