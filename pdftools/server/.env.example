# Copy this file to .env and fill in real values before running the server

PORT=4000

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Where the SQLite database file is stored
DB_PATH=./data/pdfstation.db

# Where uploaded/processed files are temporarily stored
STORAGE_PATH=./storage

# Max upload size per file, in megabytes
MAX_FILE_SIZE_MB=25

# Comma-separated list of origins allowed to call this API
# e.g. http://localhost:5500,https://yourdomain.com
CORS_ORIGIN=*
